# ==============================================================================
# Переменные окружения приложения (WMS Inventory Management)
# Скопируйте этот файл в .env и при необходимости измените значения
# ==============================================================================

# Название сервиса
APP_NAME="WMS Inventory Management API"

# Окружение: development | production | test
APP_ENV=development

# Версия сервиса
APP_VERSION=1.0.0

# Порт HTTP-сервера
HTTP_PORT=8080
